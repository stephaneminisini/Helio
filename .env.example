# ─────────────────────────────────────────────────────────────────────────────
# Helio Monitor — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run: make init
# This will copy the file and auto-generate FERNET_KEY for you.
#
# ⚠️  Never commit .env to version control. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
#
# Full async PostgreSQL connection string.
# When running via Docker Compose, use 'db' as the hostname (the service name).
# Do not change the format — SQLAlchemy requires the +asyncpg driver prefix.
#
DATABASE_URL=postgresql+asyncpg://helio:changeme@db:5432/helio

# PostgreSQL credentials used by the db Docker service.
# POSTGRES_PASSWORD must match the password in DATABASE_URL above.
POSTGRES_USER=helio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=helio


# ── Enphase API ───────────────────────────────────────────────────────────────
#
# Get these from the Enphase Developer Portal:
#   https://developer-v4.enphase.com → My Apps
#
# ENPHASE_CLIENT_ID and ENPHASE_CLIENT_SECRET come from your app registration.
# ENPHASE_SYSTEM_ID is visible in your Enlighten URL:
#   https://enlighten.enphaseenergy.com/web/YOUR_SYSTEM_ID/today/graph/hours
#
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_SYSTEM_ID=

# Redirect URI for the OAuth flow. Register this exact value on your Enphase
# app (Enphase compares it on both the consent request and the code exchange).
# For cloud deploys, replace localhost:8000 with your public API URL.
ENPHASE_REDIRECT_URI=http://localhost:8000/api/auth/enphase/callback

# OAuth tokens - optional. Connecting from the Setup tab stores an encrypted
# pair in the database, which always wins over these values. Fill them in only
# to bootstrap a poll before connecting; there is no need to keep them current,
# since Enphase rotates the refresh token on every use.
ENPHASE_ACCESS_TOKEN=
ENPHASE_REFRESH_TOKEN=


# ── Security ──────────────────────────────────────────────────────────────────
#
# Fernet symmetric encryption key — used to encrypt your Enphase OAuth tokens
# before storing them in the database.
#
# Generate a key with:
#   make generate-fernet-key
# or:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  If you lose this key, you will need to re-authorize with Enphase.
# ⚠️  Do not reuse this key across different installations.
#
FERNET_KEY=


# ── Weather & Irradiance ──────────────────────────────────────────────────────
#
# Irradiance data is used to calculate weather-normalized Performance Ratio (PR).
# Without it, efficiency tracking is less accurate but the app still works.
#
# IRRADIANCE_SOURCE options:
#   nrel   — NREL PVDAQ API (best for USA and Canada, requires NREL_API_KEY)
#   nasa   — NASA POWER API (global coverage, no API key required)
#   manual — Disables weather normalization entirely
#
IRRADIANCE_SOURCE=nrel

# Required if IRRADIANCE_SOURCE=nrel
# Get a free key at: https://developer.nrel.gov/signup/
NREL_API_KEY=


# ── Polling Schedule ──────────────────────────────────────────────────────────
#
# The poller runs once daily to fetch new production data from Enphase.
# Set POLL_HOUR to a time after your solar day ends and Enphase has finished
# processing data — 4 AM local time is a safe default.
#
# POLL_HOUR: 0–23 (24-hour format)
# TZ: IANA timezone name — full list at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
POLL_HOUR=4
POLL_MINUTE=0
TZ=America/Montreal


# ── Frontend ──────────────────────────────────────────────────────────────────
#
# Base URL of the API server as seen from the browser.
#
# For local installs: http://localhost:8000
# For cloud deploys:  your public API URL e.g. https://api.yourdomain.com
#
# This value is baked into the frontend at build time (Vite build arg).
# After changing it, rebuild the frontend container: make build
#
VITE_API_BASE_URL=http://localhost:8000

# Base URL of the dashboard as seen from the browser. The Enphase OAuth
# callback sends the browser back here once the tokens are stored.
FRONTEND_BASE_URL=http://localhost:3000
